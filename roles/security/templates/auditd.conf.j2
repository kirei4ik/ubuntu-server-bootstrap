# Ansible managed - do not edit manually
#
# Настройки демона auditd
#

# Локальный файл аудита
log_file = {{ security.auditd.log_file }}

# Формат логов
log_format = {{ security.auditd.log_format }}

# Группа для логов
log_group = {{ security.auditd.log_group }}

# Частота сброса на диск
flush = {{ security.auditd.flush }}

# Частота записи логов
freq = {{ security.auditd.freq }}

# Максимальный размер файла лога (в MB)
max_log_file = {{ security.auditd.max_log_file }}

# Количество архивных логов
num_logs = {{ security.auditd.num_logs }}

# Приоритет процесса
priority_boost = {{ security.auditd.priority_boost }}

# Формат имени хоста
name_format = {{ security.auditd.name_format }}

# Действие при достижении максимального размера
max_log_file_action = {{ security.auditd.max_log_file_action }}

# Действие при мало места на диске
space_left = {{ security.auditd.space_left }}
space_left_action = {{ security.auditd.space_left_action }}

# Действие при очень мало места
admin_space_left = {{ security.auditd.admin_space_left }}
admin_space_left_action = {{ security.auditd.admin_space_left_action }}

# Действие при полном диске
disk_full_action = {{ security.auditd.disk_full_action }}

# Действие при ошибке диска
disk_error_action = {{ security.auditd.disk_error_action }}

# Использовать TCP wrappers
use_libwrap = {{ "true" if security.auditd.use_libwrap else "false" }}

# Настройки TCP сервера
tcp_listen_queue = {{ security.auditd.tcp_listen_queue }}
tcp_max_per_addr = {{ security.auditd.tcp_max_per_addr }}
tcp_client_max_idle = {{ security.auditd.tcp_client_max_idle }}

# Kerberos настройки
enable_krb5 = {{ "true" if security.auditd.enable_krb5 else "false" }}
krb5_principal = {{ security.auditd.krb5_principal }}

# Дополнительные настройки
distribute_network = no
q_depth = 2000
overflow_action = SYSLOG
max_restarts = 10
plugin_dir = /etc/audit/plugins.d
end_of_event_timeout = 2

# Настройки взаимодействия с syslog
syslog_format = ENHANCED

# Настройки записи
write_logs = yes

# Ротация логов
rotate_interval = daily

# Сжатие архивных логов
compress = yes