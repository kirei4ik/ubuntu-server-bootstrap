#!/bin/bash
set -euo pipefail

REPO="{{ backup.restic.repository }}"
PASS_FILE="/etc/backup/restic-password"

if [ $# -lt 2 ]; then
    echo "Usage: $0 <snapshot-id> <dest-path>"
    echo "List snapshots: restic -r $REPO --password-file $PASS_FILE snapshots"
    exit 1
fi

SNAPSHOT="$1"
DEST="$2"

restic -r "$REPO" --password-file "$PASS_FILE" restore "$SNAPSHOT" --target "$DEST"
