#!/bin/bash
set -euo pipefail

REPO="{{ backup.restic.repository }}"
PASS_FILE="/etc/backup/restic-password"

/usr/local/bin/restic -r "$REPO" --password-file "$PASS_FILE" forget \
{% if backup.restic.retention.keep_last is defined %}  --keep-last {{ backup.restic.retention.keep_last }} \
{% endif %}{% if backup.restic.retention.keep_daily is defined %}  --keep-daily {{ backup.restic.retention.keep_daily }} \
{% endif %}{% if backup.restic.retention.keep_weekly is defined %}  --keep-weekly {{ backup.restic.retention.keep_weekly }} \
{% endif %}{% if backup.restic.retention.keep_monthly is defined %}  --keep-monthly {{ backup.restic.retention.keep_monthly }} \
{% endif %}{% if backup.restic.retention.keep_yearly is defined %}  --keep-yearly {{ backup.restic.retention.keep_yearly }} \
{% endif %}  --prune
