#!/bin/bash
set -euo pipefail

REPO="{{ backup.restic.repository }}"
PASS_FILE="/etc/backup/restic-password"
LOG=/var/log/restic-backup.log

echo "=== $(date): Starting backup ===" | tee -a "$LOG"

# Run backup
/usr/local/bin/restic -r "$REPO" --password-file "$PASS_FILE" \
{% for dir in backup.include.directories %}  backup {{ dir }} \
{% endfor %}{% for file in backup.include.files %}  --files-from=<(echo -e '{{ file }}') \
{% endfor %}{% for pattern in backup.exclude.patterns | default([]) %}  --exclude='{{ pattern }}' \
{% endfor %}  --tag ansible \
  --cache-dir /var/cache/restic \
  --verbose 2>&1 | tee -a "$LOG"

echo "=== $(date): Backup finished ===" | tee -a "$LOG"
