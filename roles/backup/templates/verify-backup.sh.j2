#!/bin/bash
set -euo pipefail

REPO="{{ backup.restic.repository }}"
PASS_FILE="/etc/backup/restic-password"
LOG=/var/log/restic-verify.log

echo "=== $(date): Starting verify ===" | tee -a "$LOG"

/usr/local/bin/restic -r "$REPO" --password-file "$PASS_FILE" \
  check --read-data-subset=10% \
  --verbose 2>&1 | tee -a "$LOG"

echo "=== $(date): Verify finished ===" | tee -a "$LOG"
