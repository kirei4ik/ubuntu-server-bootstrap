# Netdata configuration stub
# Generated by Ansible — включите monitoring.netdata.enabled=true, чтобы активировать

[global]
  history = {{ monitoring.netdata.config.history | default('3600') }}
  memory mode = {{ monitoring.netdata.config.memory_mode | default('ram') }}
{% if monitoring.netdata.config.memory_mode | default('ram') == 'dbengine' %}
  page cache size = {{ monitoring.netdata.config.page_cache_size | default('32') }}
  dbengine disk space = {{ monitoring.netdata.config.dbengine_disk_space | default('256') }}
{% endif %}

[web]
  bind to = 0.0.0.0
  port = {{ monitoring.netdata.port | default(19999) }}
