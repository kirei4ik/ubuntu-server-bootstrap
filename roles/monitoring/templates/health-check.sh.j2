#!/bin/bash
# Health check script
# Generated by Ansible

LOG_DIR="{{ monitoring.logging.log_dir | default('/var/log/monitoring') }}"
LOG="$LOG_DIR/health-check.log"
mkdir -p "$LOG_DIR"

alert() {
    local level="$1" msg="$2"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$level] $msg" | tee -a "$LOG"
    logger -t health-check "[$level] $msg"
}

# Disk usage
{% for fs in monitoring.system_metrics.disk.filesystems | default(['/']) %}
usage=$(df -h {{ fs }} | awk 'NR==2 {print $5}' | tr -d '%')
alert INFO "Disk {{ fs }}: ${usage}%"
{% if monitoring.system_metrics.disk.warning | default(80) %}
if [ "$usage" -ge "{{ monitoring.system_metrics.disk.critical | default(90) }}" ]; then
    alert CRITICAL "Disk {{ fs }} critical: ${usage}%"
elif [ "$usage" -ge "{{ monitoring.system_metrics.disk.warning | default(80) }}" ]; then
    alert WARNING "Disk {{ fs }} warning: ${usage}%"
fi
{% endif %}
{% endfor %}

# Memory usage
mem_usage=$(free | awk 'NR==2{printf("%.0f", $3*100/$2)}')
alert INFO "Memory: ${mem_usage}%"
if [ "$mem_usage" -ge "{{ monitoring.system_metrics.memory.critical | default(95) }}" ]; then
    alert CRITICAL "Memory critical: ${mem_usage}%"
elif [ "$mem_usage" -ge "{{ monitoring.system_metrics.memory.warning | default(85) }}" ]; then
    alert WARNING "Memory warning: ${mem_usage}%"
fi

# CPU load (1 min)
load=$(uptime | awk -F'load average:' '{print $2}' | awk -F',' '{print $1}' | xargs)
alert INFO "Load average (1m): $load"

# SSH port check
if ! nc -z -w2 localhost {{ monitoring.system_metrics.ssh.port | default(22) }} 2>/dev/null; then
    alert CRITICAL "SSH port {{ monitoring.system_metrics.ssh.port | default(22) }} is not responding"
fi

echo "$(date): Health check completed" >> "$LOG"
